Power of Three

Brute force

class Solution {
public:
    bool isPowerOfThree(int n) {
        while (n > 0) {
            if (n == 1) return true;
            if (n % 3 != 0) return false;
            n /= 3;
        }
        return false;
    }
};


Optimal Solution

class Solution {
public:
    bool isPowerOfThree(int n) {
       
        return (n > 0 && 1162261467 % n == 0);
    }
};


