Majority Element

Brute force


#include <bits/stdc++.h>
using namespace std;

int majorityElement(vector<int> v) {

 
    int n = v.size();

    for (int i = 0; i < n; i++) {
       
        int cnt = 0;
        for (int j = 0; j < n; j++) {
        
            if (v[j] == v[i]) {
                cnt++;
            }
        }

       
        if (cnt > (n / 2))
            return v[i];
    }

    return -1;
}

int main()
{
    vector<int> arr = {2, 2, 1, 1, 1, 2, 2};
    int ans = majorityElement(arr);
    cout << "The majority element is: " << ans << endl;
    return 0;
}


optimal solution

class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int n = nums.size();
        int count = 0, element;

        for (int i = 0; i < n; i++) {
            if (count == 0) {
                count = 1;
                element = nums[i];
            } else if (element == nums[i]) {
                count++;
            } else {
                count--;
            }
        }

        int count1 = 0;
        for (int i = 0; i < n; i++) {
            if (nums[i] == element) count1++;
        }

        if (count1 > (n / 2)) return element;
        return -1;
    }
};
