Find all numbers disaappeared from  aaray

brute force

class Solution {
public:
    vector<int> findDisappearedNumbers(vector<int>& nums) {
        unordered_set<int> numSet;
        vector<int> ans;

       
        for (int i = 0; i < nums.size(); i++) {
            numSet.insert(nums[i]); 
        }

       
        for (int i = 1; i <= nums.size(); i++) {
            if (numSet.find(i) == numSet.end()) { 
                ans.push_back(i);
            }
        }

        return ans;
    }
};

optimal solution

class Solution {
public:
    vector<int> findDisappearedNumbers(vector<int>& nums) {
        vector<int> result;

        
        for (int i = 0; i < nums.size(); i++) {
            int index = abs(nums[i]) - 1;
            if (nums[index] > 0)
                nums[index] *= -1;
        }

       
        for (int i = 0; i < nums.size(); i++) {
            if (nums[i] > 0)
                result.push_back(i + 1);
        }

        return result;
    }
};

