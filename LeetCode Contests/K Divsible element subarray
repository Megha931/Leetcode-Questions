K Divsible element subarray

class Solution {
public:
    int countDistinct(vector<int>& nums, int k, int p) {
                int n = nums.size();
        set<vector<int>> subarrays;

        for(int i = 0; i < n; i++) {
            int count = 0;
            vector<int> current;

            for(int j = i; j < n; j++) {
                current.push_back(nums[j]);

                if (nums[j] % p == 0)
                    count++;

                if (count > k)
                    break;

                subarrays.insert(current);
            }
        }

        return subarrays.size();
    }
}
