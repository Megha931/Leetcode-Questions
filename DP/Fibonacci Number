Fibonacci Number 


#Memoizaton


int f(int n, vector<int>& dp){
    if(n<=1) return n;
    
    if(dp[n]!= -1) return dp[n];
    return dp[n]= f(n-1,dp) + f(n-2,dp);
}


# Tabulation

int main() {

  int n=5;
  vector<int> dp(n+1,-1);
  
  dp[0]= 0;
  dp[1]= 1;
  
  for(int i=2; i<=n; i++){
      dp[i] = dp[i-1]+ dp[i-2];
  }
  cout<<dp[n];
  return 0;
}

# Space Optimization

class Solution {
public:
    int fib(int n) {
        int previous = 0, current = 1;
        while (n--) {
            int next = previous + current;
            previous = current;
            current = next;
        }
        return previous;
    }
};


