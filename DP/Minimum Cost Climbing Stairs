Minimum Cost Climbing Stairs

Memoization

class Solution {
public:

    int minCostOfClimbing(int n, vector<int>& cost, vector<int>& dp) {
        if (n < 0) return 0;
        if (n == 0 || n == 1) return cost[n];

        if (dp[n] != -1) return dp[n];

        int oneStep = minCostOfClimbing(n - 1, cost, dp);
        int twoSteps = minCostOfClimbing(n - 2, cost, dp);

        dp[n] = cost[n] + min(oneStep, twoSteps);
        return dp[n];
    }

    int minCostClimbingStairs(vector<int>& cost) {
        int n = cost.size();
        vector<int> dp(n + 1, -1);

       
        return min(minCostOfClimbing(n - 1, cost, dp),
                   minCostOfClimbing(n - 2, cost, dp));
    }
};

Tabulatiion

class Solution {
public:
    int minCostClimbingStairs(vector<int>& cost) {
        int n = cost.size();
        vector<int> dp(n);

       
        dp[0] = cost[0];
        dp[1] = cost[1];

       
        for (int i = 2; i < n; ++i) {
            dp[i] = cost[i] + min(dp[i - 1], dp[i - 2]);
        }

       
        return min(dp[n - 1], dp[n - 2]);
    }
};

Space Optimisation

class Solution {
public:
    int minCostClimbingStairs(vector<int>& cost) {
        int n = cost.size();

        int prev2 = cost[0];  
        int prev1 = cost[1];  

        for (int i = 2; i < n; ++i) {
            int curr = cost[i] + min(prev1, prev2);
            prev2 = prev1;
            prev1 = curr;
        }

        return min(prev1, prev2); 
    }
};

