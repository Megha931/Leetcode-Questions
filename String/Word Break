Word Break


Brute force

class Solution {
public:
    bool canBreak(string s, unordered_set<string>& wordSet) {
        if (s.empty()) return true;

        for (int i = 1; i <= s.length(); i++) {
            string prefix = s.substr(0, i);
            if (wordSet.count(prefix)) {
                string suffix = s.substr(i);
                if (canBreak(suffix, wordSet)) {
                    return true;
                }
            }
        }
        return false;
    }

    bool wordBreak(string s, vector<string>& wordDict) {
        unordered_set<string> wordSet(wordDict.begin(), wordDict.end());
        return canBreak(s, wordSet);
    }
};

Better Solution

class Solution {
public:
    bool wordBreak(string s, vector<string>& wordDict) {
        unordered_set<string> wordSet(wordDict.begin(), wordDict.end());
        int n = s.length();
        vector<bool> dp(n + 1, false);
        dp[0] = true; 

        for (int i = 1; i <= n; i++) {
            for (int j = 0; j < i; j++) {
                if (dp[j] && wordSet.count(s.substr(j, i - j))) {
                    dp[i] = true;
                    break;
                }
            }
        }

        return dp[n];
    }
};

Optimal Approach

class Solution {
public:
    bool wordBreak(string s, vector<string>& wordDict) {
        unordered_set<string> wordSet(wordDict.begin(), wordDict.end());
        int n = s.size();

        int minLen = INT_MAX, maxLen = INT_MIN;
        for (string& word : wordDict) {
            int len = word.length();
            minLen = min(minLen, len);
            maxLen = max(maxLen, len);
        }

        vector<bool> dp(n + 1, false);
        dp[0] = true;

        for (int i = 1; i <= n; i++) {
            for (int len = minLen; len <= maxLen; len++) {
                if (i - len >= 0 && dp[i - len]) {
                    string sub = s.substr(i - len, len);
                    if (wordSet.count(sub)) {
                        dp[i] = true;
                        break;
                    }
                }
            }
        }

        return dp[n];
    }
};

