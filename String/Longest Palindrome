Longest Palindrome


class Solution {
public:
    int longestPalindrome(string s) {
        map<char, int> count;

      
        for (char ch : s) {
            count[ch]++;
        }

        int size = 0;
        bool oddFound = false;

       
        for (auto it : count) {
            if (it.second % 2 == 0) {
                size += it.second;
            } else {
                size += it.second - 1;  
                oddFound = true;      
            }
        }

        if (oddFound) return size + 1;
        return size;
    }
};
