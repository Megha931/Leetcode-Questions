Word Pattern

class Solution {
public:
    bool wordPattern(string pattern, string s) {
        map<char, string> check;
        map<string, char> reverse_check;

        vector<string> words;
        string word;
        istringstream iss(s);

        while (iss >> word) {
            words.push_back(word);
        }

        if (words.size() != pattern.size())
            return false;

        for (int i = 0; i < pattern.size(); i++) {
            char ch = pattern[i];
            string w = words[i];

            if (check.find(ch) != check.end()) {
                if (check[ch] != w)
                    return false;
            } else {
                if (reverse_check.find(w) != reverse_check.end())
                    return false;

                check[ch] = w;
                reverse_check[w] = ch;
            }
        }

        return true;
    }
};
