Isomorphic String

class Solution {
public:
    bool isIsomorphic(string s, string t) {
        map<char, char> check;
        map<char, char> reverse_check;

        for(int i = 0; i < s.length(); i++) {
            if(check.find(s[i]) != check.end()) {
                if(check[s[i]] != t[i])
                    return false;
            } else {
               
                if(reverse_check.find(t[i]) != reverse_check.end())
                    return false;
                
                check[s[i]] = t[i];
                reverse_check[t[i]] = s[i];
            }
        }
        return true;
    }
};


Optimal Approach

class Solution {
public:
    bool isIsomorphic(string s, string t) {
        if (s.length() != t.length()) return false;

        int mapS[256] = {0};  
        int mapT[256] = {0};  

        for (int i = 0; i < s.length(); i++) {
            char cs = s[i];
            char ct = t[i];

           
            if (mapS[cs] != mapT[ct])
                return false;

            
            mapS[cs] = i + 1;
            mapT[ct] = i + 1;
        }

        return true;
    }
};


