Longest substring with k unique characters

Brute Force

class Solution {
  public:
    int longestKSubstr(string &s, int k) {
    int ans = -1;  
    
    
    unordered_set<char> st;  


    for (int i = 0; i < s.size(); i++) {
        
        
        st.clear();  

        
        for (int j = i; j < s.size(); j++) {
            st.insert(s[j]); 

           
            if (st.size() == k) {
                ans = max(ans, j - i + 1);
            }
    
            if(st.size() > k) break;
        }
    }

    return ans;
        
    }
};

Better Solution

class Solution {
  public:
    int longestKSubstr(string &s, int k) {
       
       int l=0, r=0;
       map<char, int> check;
       int maxLen=-1;
       
       while(r<s.length()){
           
           check[s[r]]++;
           
           while(check.size()>k){
               check[s[l]]--;
               if (check[s[l]] == 0) check.erase(s[l]);
               l=l+1;
               
           }
           
           if(check.size()==k){
               maxLen= max(maxLen, r-l+1);
           }
           
           r=r+1;
           
       }
        return maxLen;
    }
};




